# Mật khẩu mở trang quản trị
ADMIN_PASSWORD=change-me
# Chuỗi ngẫu nhiên dài để ký phiên đăng nhập
SESSION_SECRET=replace-with-at-least-32-random-characters

# ID của một Google Sheet trống dùng làm cơ sở dữ liệu
GOOGLE_DATA_SPREADSHEET_ID=

# Cách 1 (khuyên dùng): OAuth của tài khoản studio
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Cách 2: service account (chia sẻ Sheet + thư mục Drive cho email này)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# URL production, ví dụ https://select.ananstudio.vn
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Thông báo email (Resend). Bỏ trống cả ba biến để tắt thông báo.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM="ANAN DP Select <notify@your-domain.com>"
NOTIFICATION_EMAIL_TO=studio@your-domain.com

# Thông báo Telegram (BotFather + chat/group ID). Bỏ trống cả hai biến để tắt.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bảo vệ cron kiểm tra thẻ đến Ngày 7 (chuỗi ngẫu nhiên tối thiểu 16 ký tự)
CRON_SECRET=
